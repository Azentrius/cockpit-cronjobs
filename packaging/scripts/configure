# shellcheck shell=sh
# After every install and upgrade of cockpit-cronjobs (as root; also `make install`).
# SPDX-License-Identifier: Apache-2.0
#
# The status for the Status Board: the timer is on, unless the administrator masked it
# (enabling a masked unit fails, and that is fine). A new version may write the status
# differently, so it is written again right away.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload || true
fi
if command -v systemctl > /dev/null 2>&1; then
    systemctl enable cockpit-cronjobs-status.timer > /dev/null 2>&1 || true
fi
if [ -d /run/systemd/system ] && systemctl is-enabled --quiet cockpit-cronjobs-status.timer 2> /dev/null; then
    systemctl restart cockpit-cronjobs-status.timer || true
    systemctl start --no-block cockpit-cronjobs-status.service || true
fi
