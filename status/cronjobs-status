#!/bin/sh
# cronjobs-status: the status of Cron Jobs for the Azentrius Status Board, in the status format
# that every Azentrius Cockpit add-on shares (schema 1). Part of Cron Jobs, the Cockpit page
# (https://github.com/Azentrius/cockpit-cronjobs).
#
# Usage:
#   cronjobs-status status [--lang en|de]   print the status as JSON; reads only the status file
#                                           of that language, so it needs no root (any other
#                                           language Cockpit may use gets English)
#   cronjobs-status write                   as root: work the status out and write it to
#                                           /var/lib/cockpit-cronjobs/status.json (English) and
#                                           status.de.json (German), mode 644
#
# cockpit-cronjobs-status.timer runs "write" every 15 minutes. It reads the crontabs of root and
# of the other users and the recorded runs of their jobs (see cockpit-cronjobs-run), the runs of
# the jobs converted from them to systemd timers (from the journal), whether the cron service
# runs, and, when Debian's cron logs failed jobs and their starts (-L with 4 and 1), cron's log of the last 24 hours, and
# writes only numbers, states, job IDs, unit names and paths: no user names, no commands, no
# output. A job counts as failed when one of its recorded runs in the last 24 hours ended with an
# exit code other than 0 or was aborted, as on the page; a converted job when systemd says a run of
# its service in the last 24 hours failed, or the run lost its end; any other job of those crontabs,
# /etc/crontab and /etc/cron.d when cron logged that a run of it started in the last 24 hours
# failed (the page's CRON_LOG_SCRIPT reads the same lines).
#
# Exit codes: 0 done (a failed job is a finding, not an error), 64 wrong call, 77 "write" without
# root, 1 the status could not be written.
#
# SPDX-License-Identifier: Apache-2.0
set -u
LC_ALL=C
export LC_ALL

# CRONJOBS_STATE_DIR, CRONJOBS_SPOOL_DIR, CRONJOBS_PAGE_DIR, CRONJOBS_UNIT_DIR, CRONJOBS_SYSTEMD,
# CRONJOBS_ETC_DIR and CRONJOBS_CRON_ARGS are for the tests.
state=${CRONJOBS_STATE_DIR:-/var/lib/cockpit-cronjobs}
units=${CRONJOBS_UNIT_DIR:-/etc/systemd/system}
etc=${CRONJOBS_ETC_DIR:-/etc}
# Seconds after which the Status Board calls the status stale: four runs of the timer missed.
stale=3600
# Failed runs count for 24 hours.
window=86400
# The run recorder keeps the last 20 runs of a job; the page reads no more.
keep=20
# Failed jobs named in the detail; the rest is a number.
named=5

usage() {
    echo "usage: cronjobs-status status [--lang en|de] | cronjobs-status write" >&2
    exit 64
}

# say ENGLISH GERMAN: the text in the language asked for.
say() {
    if [ "$lang" = de ]; then printf '%s' "$2"; else printf '%s' "$1"; fi
}

# The version of the page, from its app.js (the only place it lives), or nothing.
version() {
    if [ -n "${CRONJOBS_PAGE_DIR-}" ]; then
        set -- "$CRONJOBS_PAGE_DIR/app.js"
    else
        set -- /usr/share/cockpit/cronjobs/app.js /usr/local/share/cockpit/cronjobs/app.js
    fi
    for js in "$@"; do
        [ -f "$js" ] || continue
        v=$(sed -n 's/^ *const VERSION = "\([0-9][0-9A-Za-z.+~-]*\)";.*$/\1/p' "$js" | head -n 1)
        if [ -n "$v" ] && [ ${#v} -le 32 ]; then
            printf '%s' "$v"
            return
        fi
    done
}

# The start of a status document, up to the items.
head_json() {
    printf '{"schema":1,"addon":"cronjobs","label":"Cron Jobs",'
    v=$(version)
    if [ -n "$v" ]; then printf '"version":"%s",' "$v"; fi
    printf '"checked_at":"%s","state":"%s","summary":"%s","items":[' "$checked" "$1" "$2"
}

# Where a click on the Status Board goes: the place on the page that shows the item (PLACES in
# src/app/tabs.js): the latest results with the failures first, the crontabs, the notices (where
# the page says that cron is not running).
link() {
    case $1 in
        failed) printf '#/overview/results' ;;
        unrecorded) printf '#/overview/crontab' ;;
        cron) printf '#/overview/notices' ;;
    esac
}

# item ID STATE TITLE VALUE DETAIL (VALUE may be empty)
item() {
    printf '{"id":"%s","state":"%s","title":"%s",' "$1" "$2" "$3"
    if [ -n "$4" ]; then printf '"value":"%s",' "$4"; fi
    printf '"detail":"%s",' "$5"
    place=$(link "$1")
    if [ -n "$place" ]; then printf '"link":"%s",' "$place"; fi
    printf '"checked_at":"%s","stale_after":%s}' "$checked" "$stale"
}

# The jobs of a crontab (standard input), one line each: "J ID" for a job whose runs are recorded,
# "U KEY" for one that is not, KEY being how cron logs its start: "(USER) CMD (COMMAND)", USER the
# crontab's owner (owner=), COMMAND as C.loggedCommand makes it (logged). A job is what the page
# takes for an enabled job (C.parseUserCrontab): not a comment or a variable, a known @nickname or
# five valid schedule fields, then a command; in a system crontab (sys=1: /etc/crontab, /etc/cron.d,
# C.parseSystemCrontab) the user between them. Recorded means wrapped as C.unwrapCommand reads it:
# /…/cockpit-cronjobs-run, an ID and the command in single quotes ('…' and \' only), not blank.
JOBS_AWK='
function val(t, f,   n, i, a) {
    if (t ~ /^[0-9]+$/) {
        n = t + 0
        return (n >= lo[f] && n <= hi[f]) ? n : -1
    }
    if ((f == 4 || f == 5) && t ~ /^[A-Za-z][A-Za-z][A-Za-z]$/) {
        n = split(f == 4 ? "jan feb mar apr may jun jul aug sep oct nov dec" : "sun mon tue wed thu fri sat", a, " ")
        for (i = 1; i <= n; i++) if (a[i] == tolower(t)) return f == 4 ? i : i - 1
    }
    return -1
}
function field(s, f,   items, n, i, k, base, step, r, x) {
    n = split(s, items, ",")
    for (i = 1; i <= n; i++) {
        base = items[i]
        k = index(base, "/")
        if (k > 0) {
            step = substr(base, k + 1)
            base = substr(base, 1, k - 1)
            if (step !~ /^[0-9]+$/ || step + 0 < 1) return 0
        }
        if (base == "*") continue
        r = split(base, x, "-")
        if (r < 1 || r > 2 || val(x[1], f) < 0) return 0
        if (r == 2) {
            if (val(x[2], f) < val(x[1], f)) return 0
        } else if (k > 0) return 0
    }
    return n > 0
}
function unquoted(s,   out, i, j, c, n) {
    out = ""
    i = 1
    n = length(s)
    while (i <= n) {
        c = substr(s, i, 1)
        if (c == q) {
            j = index(substr(s, i + 1), q)
            if (j == 0) return 0
            out = out substr(s, i + 1, j - 1)
            i += j + 1
        } else if (c == "\\" && substr(s, i + 1, 1) == q) {
            out = out q
            i += 2
        } else return 0
    }
    return out ~ /[^[:space:]]/
}
function recorded(c,   s, w) {
    if (!match(c, /^\/[^[:space:]]*\/cockpit-cronjobs-run[[:space:]]+/)) return 0
    s = substr(c, RLENGTH + 1)
    if (!match(s, /^[A-Za-z0-9_-]+[[:space:]]+/)) return 0
    w = substr(s, 1, RLENGTH)
    sub(/[[:space:]]+$/, "", w)
    if (length(w) > 64 || !unquoted(substr(s, RLENGTH + 1))) return 0
    id = w
    return 1
}
# What cron hands to the shell (C.cronCommand: up to the first % not escaped, \% as %), then its
# bytes as cron logs them (C.mkprints: below 32 as ^X, DEL as ^?, from 128 as \ooo).
function logged(s,   c, i, n, ch, esc, out, b) {
    c = ""
    esc = 0
    n = length(s)
    for (i = 1; i <= n; i++) {
        ch = substr(s, i, 1)
        if (esc) {
            esc = 0
            if (ch == "%") c = substr(c, 1, length(c) - 1) "%"
            else c = c ch
            continue
        }
        if (ch == "%") break
        if (ch == "\\") esc = 1
        c = c ch
    }
    out = ""
    n = length(c)
    for (i = 1; i <= n; i++) {
        ch = substr(c, i, 1)
        b = ord[ch]
        if (b < 32) out = out "^" sprintf("%c", b + 64)
        else if (b == 127) out = out "^?"
        else if (b >= 128) out = out sprintf("\\%03o", b)
        else out = out ch
    }
    return out
}
BEGIN {
    split("0 0 1 1 0", lo, " ")
    split("59 23 31 12 7", hi, " ")
    for (i = 1; i < 256; i++) ord[sprintf("%c", i)] = i
}
{
    t = $0
    sub(/^[[:space:]]+/, "", t)
    if (t == "" || substr(t, 1, 1) == "#" || t ~ /^[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=/) next
    if (substr(t, 1, 1) == "@") {
        if (!match(t, /^@[A-Za-z0-9_]+[[:space:]]+/)) next
        nick = substr(t, 1, RLENGTH)
        sub(/[[:space:]]+$/, "", nick)
        if (nick !~ /^@(reboot|yearly|annually|monthly|weekly|daily|midnight|hourly)$/) next
    } else {
        if (!match(t, /^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+/)) next
        split(substr(t, 1, RLENGTH), fld, "[[:space:]]+")
        for (i = 1; i <= 5; i++) if (!field(fld[i], i)) next
    }
    cmd = substr(t, RLENGTH + 1)
    user = owner
    if (sys) {
        if (!match(cmd, /^[^[:space:]]+[[:space:]]+/)) next
        user = substr(cmd, 1, RLENGTH)
        sub(/[[:space:]]+$/, "", user)
        cmd = substr(cmd, RLENGTH + 1)
    }
    sub(/[[:space:]]+$/, "", cmd)
    if (cmd == "") next
    if (!sys && recorded(cmd)) print "J " id
    else print "U (" user ") CMD (" logged(cmd) ")"
}
'

# Whether one of the records (standard input, lines of runs.jsonl) started at or after "since"
# and did not end with exit code 0 (a failure, or aborted), as R.outcome sees it.
FAILED_AWK='
/^\{/ {
    if (!match($0, /"start":[0-9]+/)) next
    if (substr($0, RSTART + 8, RLENGTH - 8) + 0 < since + 0) next
    if ($0 ~ /"aborted":true/ || $0 !~ /"rc":0[,}]/) found = 1
}
END { exit !found }
'

# Whether one of the last "keep" runs of a service (standard input: journalctl -o json, oldest
# first) started at or after "since" and did not succeed, as R.parseJournal and R.outcome see it.
# systemd's own messages (_PID 1) carry the run in INVOCATION_ID, the lines the job wrote in
# _SYSTEMD_INVOCATION_ID; only systemd's say how a run ended, so a job cannot forge them. A run
# failed when systemd says so; one without an end lost it, unless it is the newest (running).
TIMER_AWK='
function field(name) {
    if (!match($0, "\"" name "\":\"[^\"]*\"")) return ""
    return substr($0, RSTART + length(name) + 4, RLENGTH - length(name) - 5)
}
/^\{/ {
    own = field("_PID") == "1"
    id = own ? field("INVOCATION_ID") : field("_SYSTEMD_INVOCATION_ID")
    if (id !~ /^[0-9a-f]+$/ || length(id) != 32) next
    ts = field("__REALTIME_TIMESTAMP")
    if (ts !~ /^[0-9]+$/ || ts + 0 <= 0) next
    if (!(id in start)) {
        n++
        ids[n] = id
        start[id] = ts + 0
    } else if (ts + 0 < start[id]) start[id] = ts + 0
    if (!own) next
    m = field("MESSAGE_ID")
    if (m == "d9b373ed55a64feb8242e02dbe79a49c" || m == "be02cf6855d2428ba40df7e9d022f03d") failed[id] = 1
    else if (m == "7ad2d189f7e94e70a38c781354912448" || (m == "39f53479d3a045ac8e11786248231fbf" && field("JOB_RESULT") == "done")) done[id] = 1
}
END {
    for (k = n - keep + 1; k <= n; k++) {
        if (k < 1) continue
        id = ids[k]
        if (start[id] < since * 1000000) continue
        if (failed[id] || (!done[id] && k < n)) found = 1
    }
    exit !found
}
'

# The jobs that cron's log (standard input: journalctl -o short-unix, oldest first) says failed,
# each once, as JOBS_AWK names them: "(USER) CMD (COMMAND)" of a start whose failure "(CRON) error
# (grandchild #PID failed with exit status N)" or "... terminated by signal N" names its PID, as the
# page reads them (CRON_LOG_SCRIPT). PID is the job's: that of the start line, or "[PID]" before
# the command in it (-L 8); with that, the line must come from the process that logged the start.
# A PID belongs to its run only while the run goes on: until its end (END, CMDEND) or another boot
# ("-- Boot" between the lines), so a PID used again later (by what feeds a job what follows a %,
# which logs no start and may die of SIGPIPE) is not the old run's. A PID that started no job is left
# out, and so are jobs of the run recorder: their runs count from their records.
FAILURES_AWK='
# "(USER) CMD (COMMAND)" of message m, whose event is ev; n the PID before COMMAND, or ""; c COMMAND
function job(m, ev,   j) {
    j = index(m, " " ev " (") + length(ev) + 2
    c = substr(m, j + 1, length(m) - j - 1)
    n = ""
    if (c ~ /^[[][0-9]+[]] /) { n = substr(c, 2, index(c, "]") - 2); c = substr(c, index(c, " ") + 1) }
    return substr(m, 1, index(m, ")")) " CMD (" c ")"
}
function forget(x) { delete key[x]; delete par[x]; delete own[x] }
# open[k]: the runs of command k that may still go on (" PID PID ", at most 20); amb[k] of them ended
# with an end that did not say which (overlapping runs, no PIDs in the lines), as the page reads them
function opened(k, x,   a, z) {
    open[k] = ((k in open) ? open[k] : " ") x " "
    if (split(open[k], a, " ") > 20) { z = a[1]; sub(" " z " ", " ", open[k]); if (key[z] == k) forget(z) }
}
function close1(k, x) {
    sub(" " x " ", " ", open[k])
    if ((x in key) && key[x] == k) forget(x)
}
function ended(k, x,   a, i, c) {
    close1(k, x)
    c = split(open[k], a, " ")
    if (c > 0 && c <= amb[k]) { for (i = 1; i <= c; i++) close1(k, a[i]); amb[k] = 0 }
}
/^-- / {
    if ($0 ~ /Boot|Reboot/) {
        for (x in key) forget(x)
        for (x in mid) delete mid[x]
        for (x in open) delete open[x]
        for (x in amb) delete amb[x]
    }
    next
}
{
    i = index($0, ": (")
    if (i == 0) next
    m = substr($0, i + 2)
    p = substr($0, 1, i - 1)
    if (!match(p, /[[][0-9]+[]]$/)) next
    p = substr(p, RSTART + 1, RLENGTH - 2)
    if (m ~ /^[(][^()]*[)] CMD [(].*[)]$/) {
        k = job(m, "CMD")
        if (n == "") { n = p; par[n] = "" } else par[n] = p
        key[n] = k
        opened(k, n)
        own[n] = match(c, /^\/[^ ]*\/cockpit-cronjobs-run/) && (substr(c, RLENGTH + 1, 1) == " " || substr(c, RLENGTH + 1, 1) == "^")
    } else if (m ~ /^[(]CRON[)] error [(]grandchild #[0-9]+ (failed with exit status|terminated by signal) [0-9]+/) {
        split(m, w, " ")
        n = substr(w[4], 2)
        if (!(n in key) || (par[n] != "" && par[n] != p)) next
        mid[p] = n
        if (own[n] || (key[n] in seen)) next
        seen[key[n]] = 1
        print key[n]
    } else if (m ~ /^[(][^()]*[)] (END|CMDEND) [(].*[)]$/) {
        ev = substr(m, index(m, ") ") + 2)
        k = job(m, substr(ev, 1, index(ev, " ") - 1))
        if (n == "" && (p in mid)) n = mid[p]
        delete mid[p]
        if (n != "") {
            if ((n in key) && key[n] == k && (par[n] == "" || par[n] == p)) ended(k, n)
        } else if (k in open) {
            c = split(open[k], a, " ")
            if (c - amb[k] == 1 && amb[k] == 0) ended(k, a[1])
            else if (c - amb[k] == 1) { for (i = 1; i <= c; i++) close1(k, a[i]); amb[k] = 0 }
            else if (c - amb[k] > 1) amb[k]++
        }
    }
}
'

# Whether the -L of a cron command line (standard input, as BASICS_SCRIPT reads it) has 4 and 1:
# Debian's cron then logs failed jobs, and their starts, which say which job a failure is of (without
# them a failure belongs to no job, and nothing can be said). As C.cronLogs reads it: 1 without one,
# the last one counting (getopt "fPlL:nNx:", atoi).
LEVEL_AWK='
{
    level = 1
    for (k = 2; k <= NF; k++) {
        w = $k
        if (w == "--") break
        if (w !~ /^-[^-]/) continue
        for (j = 2; j <= length(w); j++) {
            c = substr(w, j, 1)
            if (c != "L" && c != "x") continue
            if (j < length(w)) v = substr(w, j + 1)
            else v = $(++k)
            if (c == "L") level = int(v)
            break
        }
    }
    level = (level % 16 + 16) % 16
    if (int(level / 4) % 2 && level % 2) exit 0
    exit 1
}
'

# failed USER ID: whether the job ID of USER failed since $since. Root's runs are in runs/ID,
# another user's in users/USER/runs/ID, a directory that belongs to that user: only what has the
# form of runs counts there (no links, regular files read under a time limit), as on the page, and
# no more than 64 KiB of each file is held, whatever the user puts there in the meantime.
failed() {
    if [ "$1" = root ]; then
        d=$state/runs/$2
    else
        [ ! -L "$state/users/$1" ] && [ ! -L "$state/users/$1/runs" ] || return 1
        d=$state/users/$1/runs/$2
    fi
    [ -d "$d" ] && [ ! -L "$d" ] || return 1
    f=$d/runs.jsonl
    if [ -f "$f" ] && [ ! -L "$f" ] &&
            timeout 5 tail -c 65536 "$f" 2> /dev/null | tail -n "$keep" | awk -v since="$since" "$FAILED_AWK"; then
        return 0
    fi
    # A run whose recorder is gone without a record (killed, power loss) counts as aborted.
    for r in "$d"/*.running; do
        [ -f "$r" ] && [ ! -L "$r" ] || continue
        line=$(timeout 5 head -c 4096 "$r" 2> /dev/null | head -n 1)
        pid=$(printf '%s\n' "$line" | sed -n 's/.*"pid":\([0-9][0-9]*\).*/\1/p' | head -n 1)
        if [ -n "$pid" ] && [ -r "/proc/$pid/cmdline" ] &&
                tr '\000' ' ' < "/proc/$pid/cmdline" | grep -q cockpit-cronjobs-run; then
            continue
        fi
        s=$(printf '%s\n' "$line" | sed -n 's/.*"start":\([0-9][0-9]*\).*/\1/p' | head -n 1)
        if [ -n "$s" ] && [ ${#s} -le 12 ] && [ "$s" -ge "$since" ]; then
            return 0
        fi
    done
    return 1
}

# The directory of the crontabs of root and the other users, as the page finds it.
spool() {
    if [ -n "${CRONJOBS_SPOOL_DIR-}" ]; then
        printf '%s' "$CRONJOBS_SPOOL_DIR"
        return
    fi
    for d in /var/spool/cron/crontabs /var/spool/cron/tabs /var/spool/cron; do
        if [ -d "$d" ]; then
            printf '%s' "$d"
            return
        fi
    done
}

# Whether systemd runs this system, as the page asks it (CRONJOBS_SYSTEMD=yes or no for the tests).
has_systemd() {
    case ${CRONJOBS_SYSTEMD-} in
        no) return 1 ;;
        yes) ;;
        *) [ -d /run/systemd/system ] || return 1 ;;
    esac
    command -v systemctl > /dev/null 2>&1
}

# The cron service as the page reads it (BASICS_SCRIPT): "UNIT STATE" with systemd, "- active" or
# "- inactive" without, nothing when there is none to ask.
cron_service() {
    if has_systemd; then
        for u in cron.service crond.service cronie.service; do
            if [ "$(systemctl show -p LoadState --value "$u" 2> /dev/null)" = loaded ]; then
                echo "$u $(systemctl is-active "$u" 2> /dev/null)"
                return
            fi
        done
    elif command -v pgrep > /dev/null 2>&1; then
        if pgrep -x cron > /dev/null || pgrep -x crond > /dev/null; then echo "- active"; else echo "- inactive"; fi
    fi
}

# The jobs converted to systemd timers, one line each: "NAME USER". Only units Cron Jobs wrote
# under that name from that user's crontab count, checked as back to cron checks them (UNITS_SCRIPT
# in the page): both are files, no links, the service begins with the header of a conversion from
# that crontab and runs as its user, and both have the description of such a conversion.
UNIT_START='# Created by Cockpit Cron Jobs from this line of the '
converted_units() {
    for s in "$units"/*.service; do
        [ -f "$s" ] && [ ! -L "$s" ] || continue
        n=${s##*/}
        n=${n%.service}
        case $n in ''|[!A-Za-z0-9]*|*[!A-Za-z0-9_.-]*) continue ;; esac
        t=$units/$n.timer
        [ -f "$t" ] && [ ! -L "$t" ] || continue
        first=$(head -n 1 "$s")
        case $first in
            "${UNIT_START}root crontab:") u=root ;;
            "${UNIT_START}crontab of "*:) u=${first#"${UNIT_START}crontab of "}; u=${u%:} ;;
            *) continue ;;
        esac
        case $u in ''|[!A-Za-z0-9_]*|*[!A-Za-z0-9._-]*) continue ;; esac
        if [ "$u" = root ]; then from='root crontab'; else from="crontab of $u"; fi
        grep -qxF "User=$u" "$s" && grep -qxF "Description=$n (from the $from)" "$s" &&
            grep -qxF "Description=$n (from the $from)" "$t" || continue
        printf '%s %s\n' "$n" "$u"
    done
}

# timer_failed NAME: whether a run of NAME.service failed since $since (see TIMER_AWK), from the
# journal as the page reads it (readJournal: the last 5000 entries, only the fields it needs where
# journalctl can leave the others out).
timer_failed() {
    f=MESSAGE_ID,INVOCATION_ID,_SYSTEMD_INVOCATION_ID,JOB_RESULT,_PID
    {
        journalctl -u "$1.service" --since "@$since" -o json --no-pager -n 5000 --output-fields="$f" 2> /dev/null ||
            journalctl -u "$1.service" --since "@$since" -o json --no-pager -n 5000 2> /dev/null
    } < /dev/null | awk -v since="$since" -v keep="$keep" "$TIMER_AWK"
}

# Counts the converted jobs into converted and bad, and writes the names of the failed timers of
# root's crontab to $tmp/failed. Those of other users' crontabs only count in hidden: the name a
# conversion suggests for them begins with the user's.
count_timers() {
    converted=0
    hidden=0
    has_systemd && command -v journalctl > /dev/null 2>&1 || return 0
    converted_units > "$tmp/units"
    while read -r name owner; do
        converted=$((converted + 1))
        timer_failed "$name" || continue
        bad=$((bad + 1))
        if [ "$owner" = root ]; then
            printf '%s.timer\n' "$name" >> "$tmp/failed"
        else
            hidden=$((hidden + 1))
        fi
    done < "$tmp/units"
}

# Counts the jobs into total, recorded and bad, writes the IDs of the failed ones to $tmp/failed
# and the others as cron's log names them to $tmp/known ("- KEY"). Crontabs of users the system
# does not know are skipped, as cron skips them.
count() {
    total=0
    recorded=0
    bad=0
    seen=' '
    : > "$tmp/failed"
    : > "$tmp/known"
    dir=$(spool)
    [ -n "$dir" ] || return 0
    for tab in "$dir"/*; do
        [ -f "$tab" ] && [ ! -L "$tab" ] || continue
        user=${tab##*/}
        case $user in .*|*~|*.tmp|tmp.*) continue ;; esac
        case $user in [!A-Za-z0-9_]*|*[!A-Za-z0-9._-]*) continue ;; esac
        id -u "$user" > /dev/null 2>&1 || continue
        if ! awk -v q="'" -v owner="$user" -v sys=0 "$JOBS_AWK" < "$tab" > "$tmp/jobs"; then
            echo "cronjobs-status: cannot read the crontab of $user" >&2
            exit 1
        fi
        sed -n 's/^U /- /p' "$tmp/jobs" >> "$tmp/known"
        while read -r kind job; do
            total=$((total + 1))
            [ "$kind" = J ] || continue
            recorded=$((recorded + 1))
            # Copied lines share an ID, and its runs.
            case $seen in *" $user/$job "*) continue ;; esac
            seen="$seen$user/$job "
            if failed "$user" "$job"; then
                bad=$((bad + 1))
                printf '%s\n' "$job" >> "$tmp/failed"
            fi
        done < "$tmp/jobs"
    done
}

# Whether Debian's cron logs failed jobs and their starts (LEVEL_AWK), from the command line of the running cron,
# read as the page reads it (BASICS_SCRIPT); CRONJOBS_CRON_ARGS stands in for it in the tests.
# cronie (crond) logs no failure.
logs_failures() {
    if [ -n "${CRONJOBS_CRON_ARGS+x}" ]; then
        a=$CRONJOBS_CRON_ARGS
    else
        p=$(pgrep -o -x cron 2> /dev/null) || return 1
        [ -r "/proc/$p/cmdline" ] || return 1
        a=$(tr '\000\n' '  ' < "/proc/$p/cmdline")
    fi
    [ -n "$a" ] || return 1
    printf '%s\n' "$a" | awk "$LEVEL_AWK"
}

# The jobs of /etc/crontab and /etc/cron.d as cron's log names them, one line each: "PATH KEY".
# Debian's cron reads only names of letters, digits, "_" and "-" in /etc/cron.d.
system_jobs() {
    if [ -f "$etc/crontab" ]; then
        awk -v q="'" -v sys=1 "$JOBS_AWK" < "$etc/crontab" | sed -n 's|^U |/etc/crontab |p'
    fi
    for f in "$etc"/cron.d/*; do
        [ -f "$f" ] || continue
        n=${f##*/}
        case $n in ''|*[!A-Za-z0-9_-]*) continue ;; esac
        awk -v q="'" -v sys=1 "$JOBS_AWK" < "$f" | sed -n "s|^U |/etc/cron.d/$n |p"
    done
}

# When cron logs failed jobs and their starts (logged=1): counts the jobs it logged a failure of since $since into
# bad, writes the paths of those in /etc/crontab and /etc/cron.d to $tmp/failed and counts those of
# the crontabs in unnamed. Only jobs that are there now count, and those that record their runs
# count from their records (count).
count_log() {
    logged=0
    unnamed=0
    logs_failures && command -v journalctl > /dev/null 2>&1 || return 0
    logged=1
    system_jobs >> "$tmp/known"
    journalctl --no-pager -o short-unix --since "@$since" _UID=0 SYSLOG_IDENTIFIER=CRON SYSLOG_IDENTIFIER=CROND < /dev/null 2> /dev/null |
        awk "$FAILURES_AWK" > "$tmp/logfailed"
    awk 'FILENAME == ARGV[1] {
             k = substr($0, index($0, " ") + 1)
             if (!(k in name) || name[k] == "-") name[k] = $1
             next
         }
         $0 in name { print name[$0] }' "$tmp/known" "$tmp/logfailed" > "$tmp/lognames"
    while read -r n; do
        bad=$((bad + 1))
        if [ "$n" = - ]; then unnamed=$((unnamed + 1)); else printf '%s\n' "$n" >> "$tmp/failed"; fi
    done < "$tmp/lognames"
}

# The failed jobs by ID or path and the failed timers of root's crontab by name, the first few and
# how many more; the timers of other users' crontabs and the failed jobs of the crontabs that do
# not record their runs only in that number.
failed_list() {
    sort -u "$tmp/failed" > "$tmp/ids"
    n=$(wc -l < "$tmp/ids" | tr -d ' ')
    if [ "$n" = 0 ]; then
        parts=
        if [ "$unnamed" = 1 ]; then
            parts=$(say "1 job without recording, from cron's log" "1 Job ohne Aufzeichnung, aus dem Log von cron")
        elif [ "$unnamed" -gt 1 ]; then
            parts=$(say "$unnamed jobs without recording, from cron's log" "$unnamed Jobs ohne Aufzeichnung, aus dem Log von cron")
        fi
        if [ "$hidden" -gt 0 ] && [ -n "$parts" ]; then parts="$parts; "; fi
        if [ "$hidden" = 1 ]; then
            parts="$parts$(say "1 timer converted from the crontab of another user" "1 aus der Crontab eines anderen Benutzers umgewandelter Timer")"
        elif [ "$hidden" -gt 1 ]; then
            parts="$parts$(say "$hidden timers converted from the crontabs of other users" "$hidden aus Crontabs anderer Benutzer umgewandelte Timer")"
        fi
        printf '%s' "$parts"
        return
    fi
    more=$((hidden + unnamed))
    if [ "$n" -gt "$named" ]; then more=$((more + n - named)); fi
    list=$(head -n "$named" "$tmp/ids" | paste -sd ',' - | sed 's/,/, /g')
    if [ "$more" -gt 0 ]; then
        list="$list $(say "and $more more" "und $more weitere")"
    fi
    printf '%s' "$list"
}

# The worst of the states given, as the status format takes it for the whole: danger, warning or
# info; else ok when one is ok; else none.
worst() {
    for s in danger warning info ok; do
        case " $* " in *" $s "*) printf '%s' "$s"; return ;; esac
    done
    printf none
}

# The status document in $lang, from what count, count_log, count_timers and cron_service found.
document() {
    known=$((recorded + converted))

    f_title=$(say "Failed jobs (last 24 hours)" "Fehlgeschlagene Jobs (letzte 24 Stunden)")
    f_value=
    if [ "$known" = 0 ] && [ "$logged" = 0 ]; then
        f_state=none
        f_detail=$(say "No job records its runs." "Kein Job zeichnet seine Läufe auf.")
    elif [ "$bad" -gt 0 ]; then
        f_state=danger
        f_value=$bad
        f_detail=$(failed_list)
    else
        f_state=ok
        f_value=0
        if [ "$logged" = 1 ] && [ "$known" = 0 ]; then
            f_detail=$(say "cron's log shows no failed job." "Das Log von cron zeigt keinen fehlgeschlagenen Job.")
        elif [ "$logged" = 1 ] && [ "$converted" -gt 0 ]; then
            f_detail=$(say "Recorded jobs: $recorded, timers converted from cron: $converted; none failed, and cron's log shows no failed job." "Aufgezeichnete Jobs: $recorded, aus cron umgewandelte Timer: $converted; keiner fehlgeschlagen, und das Log von cron zeigt keinen fehlgeschlagenen Job.")
        elif [ "$logged" = 1 ]; then
            f_detail=$(say "Recorded jobs: $recorded, none failed, and cron's log shows no failed job." "Aufgezeichnete Jobs: $recorded, keiner fehlgeschlagen, und das Log von cron zeigt keinen fehlgeschlagenen Job.")
        elif [ "$converted" -gt 0 ]; then
            f_detail=$(say "Recorded jobs: $recorded, timers converted from cron: $converted; none failed." "Aufgezeichnete Jobs: $recorded, aus cron umgewandelte Timer: $converted; keiner fehlgeschlagen.")
        else
            f_detail=$(say "Recorded jobs: $recorded, none failed." "Aufgezeichnete Jobs: $recorded, keiner fehlgeschlagen.")
        fi
    fi

    u_title=$(say "Jobs without recording" "Jobs ohne Aufzeichnung")
    plain=$((total - recorded))
    if [ "$plain" -gt 0 ] && [ "$logged" = 1 ]; then
        u_state=none
        u_value=$plain
        u_detail=$(say "$plain of $total jobs in the crontabs of root and other users; their failures show in cron's log." "$plain von $total Jobs in den Crontabs von root und anderen Benutzern; ihre Fehlschläge zeigt das Log von cron.")
    elif [ "$plain" -gt 0 ]; then
        u_state=none
        u_value=$plain
        u_detail=$(say "$plain of $total jobs in the crontabs of root and other users; their results are not known." "$plain von $total Jobs in den Crontabs von root und anderen Benutzern; ihre Ergebnisse sind nicht bekannt.")
    elif [ "$total" -gt 0 ]; then
        u_state=ok
        u_value=0
        u_detail=$(say "Every job in the crontabs of root and other users records its runs." "Jeder Job in den Crontabs von root und anderen Benutzern zeichnet seine Läufe auf.")
    else
        u_state=ok
        u_value=0
        u_detail=$(say "There are no jobs in the crontabs of root and other users." "In den Crontabs von root und anderen Benutzern gibt es keine Jobs.")
    fi

    # Stopped, it is a danger when the crontabs have jobs it no longer starts, else a warning.
    c_title=$(say "Cron service" "Cron-Dienst")
    c_unit=${cron% *}
    c_run=${cron##* }
    if [ "$c_unit" = - ]; then c_unit=cron; fi
    if [ -z "$cron" ]; then
        c_state=none
        c_value=
        c_detail=$(say "No cron service was found." "Es wurde kein cron-Dienst gefunden.")
    elif [ "$c_run" = active ]; then
        c_state=ok
        c_value=$(say running "läuft")
        c_detail=$(say "$c_unit is running." "$c_unit läuft.")
    else
        if [ "$total" -gt 0 ]; then c_state=danger; else c_state=warning; fi
        c_value=$(say stopped gestoppt)
        c_detail=$(say "$c_unit is not running, so no cron job starts." "$c_unit läuft nicht, daher startet kein cron-Job.")
    fi

    if [ "$c_state" = danger ] || [ "$c_state" = warning ]; then
        summary=$(say "The cron service is not running, so no cron job starts." "Der cron-Dienst läuft nicht, daher startet kein cron-Job.")
        if [ "$bad" = 1 ]; then
            summary="$summary $(say "1 job failed in the last 24 hours." "1 Job ist in den letzten 24 Stunden fehlgeschlagen.")"
        elif [ "$bad" -gt 1 ]; then
            summary="$summary $(say "$bad jobs failed in the last 24 hours." "$bad Jobs sind in den letzten 24 Stunden fehlgeschlagen.")"
        fi
    elif [ "$bad" -gt 0 ]; then
        if [ "$bad" = 1 ]; then
            summary=$(say "1 job failed in the last 24 hours." "1 Job ist in den letzten 24 Stunden fehlgeschlagen.")
        else
            summary=$(say "$bad jobs failed in the last 24 hours." "$bad Jobs sind in den letzten 24 Stunden fehlgeschlagen.")
        fi
    elif [ "$logged" = 1 ]; then
        summary=$(say "No job failed in the last 24 hours." "Kein Job ist in den letzten 24 Stunden fehlgeschlagen.")
    elif [ "$converted" -gt 0 ]; then
        summary=$(say "No recorded job and no converted timer failed in the last 24 hours." "Kein aufgezeichneter Job und kein umgewandelter Timer ist in den letzten 24 Stunden fehlgeschlagen.")
    elif [ "$recorded" -gt 0 ]; then
        summary=$(say "No recorded job failed in the last 24 hours." "Kein aufgezeichneter Job ist in den letzten 24 Stunden fehlgeschlagen.")
    elif [ "$total" -gt 0 ]; then
        summary=$(say "No job records its runs, so their results are not known." "Kein Job zeichnet seine Läufe auf, daher sind die Ergebnisse nicht bekannt.")
    else
        summary=$(say "There are no jobs in the crontabs of root and other users." "In den Crontabs von root und anderen Benutzern gibt es keine Jobs.")
    fi

    head_json "$(worst "$f_state" "$u_state" "$c_state")" "$summary"
    item failed "$f_state" "$f_title" "$f_value" "$f_detail"
    printf ','
    item unrecorded "$u_state" "$u_title" "$u_value" "$u_detail"
    printf ','
    item cron "$c_state" "$c_title" "$c_value" "$c_detail"
    printf ']}\n'
}

write() {
    if [ -z "${CRONJOBS_STATE_DIR-}" ] && [ "$(id -u)" != 0 ]; then
        echo "cronjobs-status: write needs root" >&2
        exit 77
    fi
    if ! command -v awk > /dev/null 2>&1; then
        echo "cronjobs-status: write needs awk" >&2
        exit 1
    fi
    umask 022
    tmp=$(mktemp -d) || exit 1
    out=
    trap 'rm -rf "$tmp"; if [ -n "$out" ]; then rm -f "$out"; fi' EXIT
    now=$(date +%s)
    since=$((now - window))
    checked=$(date -u -d "@$now" +%Y-%m-%dT%H:%M:%SZ)
    count
    count_log
    count_timers
    cron=$(cron_service)
    # 711 as the page sets it: others reach the status files by name but list nothing.
    install -d -m 711 "$state" && chmod 711 "$state" || exit 1
    for lang in en de; do
        name=status.json
        if [ "$lang" = de ]; then name=status.de.json; fi
        out=$(mktemp "$state/.status.XXXXXX") || exit 1
        document > "$out" && chmod 644 "$out" && mv -f "$out" "$state/$name" || exit 1
        out=
    done
}

# Prints the status file of $lang; without one, a status "none" that says why.
show() {
    f=$state/status.json
    if [ "$lang" = de ]; then f=$state/status.de.json; fi
    if [ -f "$f" ] && [ -r "$f" ]; then
        body=$(head -c 65536 "$f" 2> /dev/null)
        case $body in
            '{"schema":1,'*'}')
                printf '%s\n' "$body"
                return
                ;;
        esac
        reason=$(say "The status file cannot be read." "Die Statusdatei lässt sich nicht lesen.")
    elif [ -e "$f" ] || { [ -d "$state" ] && [ ! -x "$state" ]; }; then
        reason=$(say "The status file cannot be read." "Die Statusdatei lässt sich nicht lesen.")
    else
        reason=$(say "No status yet: cockpit-cronjobs-status.timer writes it every 15 minutes." "Noch kein Status: cockpit-cronjobs-status.timer schreibt ihn alle 15 Minuten.")
    fi
    checked=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    head_json none "$reason"
    printf ']}\n'
}

lang=en
case ${1-} in
    status)
        shift
        # Any language Cockpit may use: German for de and its regions (de-AT, de_CH), else English.
        if [ $# -gt 0 ]; then
            [ "$1" = --lang ] && [ $# -eq 2 ] || usage
            case $2 in *[!A-Za-z0-9_-]*) usage ;; esac
            printf '%s\n' "$2" | grep -Eqx '[A-Za-z]{2,3}([-_][A-Za-z0-9]{2,8})?' || usage
            case $2 in
                [Dd][Ee]|[Dd][Ee][-_]*) lang=de ;;
            esac
        fi
        show
        ;;
    write)
        [ $# -eq 1 ] || usage
        write
        ;;
    *)
        usage
        ;;
esac
exit 0
