# Writes the status of Cron Jobs for the Azentrius Status Board (see cronjobs-status).
# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Status of Cron Jobs for the Status Board
Documentation=https://github.com/Azentrius/cockpit-cronjobs#status-for-the-status-board

[Service]
Type=oneshot
# Through /bin/sh, not the file itself: under SELinux systemd runs a file of /usr/lib (lib_t) in its
# own domain (init_t), which may not read the users' crontabs (user_cron_spool_t), so the helper
# stopped there. A shell (shell_exec_t) runs in an unconfined domain (initrc_t), as other helpers
# run through python3 do (unconfined_service_t).
ExecStart=/bin/sh /usr/lib/cockpit-cronjobs/cronjobs-status write
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2min

# Hardening: it reads the crontabs and the recorded runs, and writes only the status files in
# /var/lib/cockpit-cronjobs. Root, because those are root's (or each user's) alone.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
